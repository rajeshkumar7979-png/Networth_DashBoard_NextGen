# Copy to .streamlit/secrets.toml (git-ignored) or paste into
# Streamlit Cloud → the app → Settings → Secrets.
# Never put a real key in a committed file.
#
# GitHub Actions needs the same values as repository secrets
# (Settings → Secrets and variables → Actions) with these names:
#   UPSTOX_ACCESS_TOKEN, FRED_API_KEY, AI_API_KEY, AI_PROVIDER,
#   AI_BASE_URL, AI_MODEL, GEMINI_API_KEY

[upstox]
ACCESS_TOKEN = "your_upstox_access_token"

[fred]
FRED_API_KEY = "your_fred_key"

[ai]
AI_API_KEY = "gsk_..."
AI_PROVIDER = "groq"
AI_BASE_URL = "https://api.groq.com/openai/v1"
AI_MODEL = "openai/gpt-oss-20b"

# Optional: switch primary AI to Gemini (OpenAI-compatible endpoint)
# AI_API_KEY = "your_gemini_key"
# AI_PROVIDER = "gemini"
# AI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
# AI_MODEL = "gemini-2.0-flash"

[gemini]
API_KEY = "your_gemini_api_key"

# Optional private workbook path (Cloud must be able to read it)
# [book]
# path = "/mount/private_Networth_Raw_Data.xlsx"
