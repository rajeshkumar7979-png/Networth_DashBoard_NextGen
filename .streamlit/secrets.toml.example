# Copy to .streamlit/secrets.toml (git-ignored) or paste into
# Streamlit Cloud → the app → Settings → Secrets.
# Never put a real key in a committed file.
# Groq retired llama-3.3-70b-versatile — use openai/gpt-oss-20b (or gpt-oss-120b).
#
# Either shape works. Cloud Secrets often get pasted top-level (no [ai] table);
# the app reads both.

[ai]
AI_API_KEY = "gsk_..."
AI_PROVIDER = "groq"
AI_BASE_URL = "https://api.groq.com/openai/v1"
AI_MODEL = "openai/gpt-oss-20b"

[fred]
FRED_API_KEY = "your-fred-key"

# Equivalent top-level form (also accepted):
# AI_API_KEY = "gsk_..."
# AI_PROVIDER = "groq"
# AI_MODEL = "openai/gpt-oss-20b"
# FRED_API_KEY = "your-fred-key"
